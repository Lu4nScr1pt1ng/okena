; io_uring ABI (include/uapi/linux/io_uring.h).

; io_uring_setup flags
IORING_SETUP_CQSIZE		:= 1 shl 3
IORING_SETUP_CLAMP		:= 1 shl 4
IORING_SETUP_R_DISABLED		:= 1 shl 6
IORING_SETUP_SUBMIT_ALL		:= 1 shl 7
IORING_SETUP_SINGLE_ISSUER	:= 1 shl 12
IORING_SETUP_DEFER_TASKRUN	:= 1 shl 13
IORING_SETUP_NO_SQARRAY		:= 1 shl 16

; features reported back by the kernel
IORING_FEAT_SINGLE_MMAP		:= 1 shl 0
IORING_FEAT_NODROP		:= 1 shl 1

; mmap offsets
IORING_OFF_SQ_RING		:= 0
IORING_OFF_SQES			:= 0x10000000

; io_uring_enter flags
IORING_ENTER_GETEVENTS		:= 1 shl 0
IORING_ENTER_REGISTERED_RING	:= 1 shl 4

; io_uring_register opcodes
IORING_REGISTER_RESTRICTIONS	:= 11
IORING_REGISTER_ENABLE_RINGS	:= 12
IORING_REGISTER_FILES2		:= 13
IORING_REGISTER_RING_FDS	:= 20
IORING_RSRC_REGISTER_SPARSE	:= 1 shl 0

; struct io_uring_params (120 bytes)
UP_SQ_ENTRIES	:= 0
UP_CQ_ENTRIES	:= 4
UP_FLAGS	:= 8
UP_FEATURES	:= 20
UP_SQ_HEAD	:= 40
UP_SQ_TAIL	:= 44
UP_SQ_MASK	:= 48
UP_SQ_ARRAY	:= 64
UP_CQ_HEAD	:= 80
UP_CQ_TAIL	:= 84
UP_CQ_MASK	:= 88
UP_CQ_CQES	:= 100
UP_SIZE		:= 120

; opcodes
IORING_OP_NOP		:= 0
IORING_OP_TIMEOUT	:= 11
IORING_OP_ACCEPT	:= 13
IORING_OP_LINK_TIMEOUT	:= 15
IORING_OP_CONNECT	:= 16
IORING_OP_ASYNC_CANCEL	:= 14
IORING_OP_CLOSE		:= 19
IORING_OP_READ		:= 22
IORING_OP_SEND		:= 26
IORING_OP_RECV		:= 27
IORING_OP_SHUTDOWN	:= 34
IORING_OP_URING_CMD	:= 46

; struct io_uring_restriction (16 bytes): dw opcode, db op, ...
IORING_RESTRICTION_SQE_OP		:= 1
IORING_RESTRICTION_SQE_FLAGS_ALLOWED	:= 2

; sqe->flags
IOSQE_FIXED_FILE	:= 1 shl 0
IOSQE_IO_LINK		:= 1 shl 2
IOSQE_CQE_SKIP_SUCCESS	:= 1 shl 6

; op-specific flags
IORING_ACCEPT_MULTISHOT	:= 1 shl 0	; in sqe->ioprio
IORING_FILE_INDEX_ALLOC	:= 0xFFFFFFFF
IORING_TIMEOUT_MULTISHOT := 1 shl 6
IORING_ASYNC_CANCEL_ALL	:= 1 shl 0
IORING_ASYNC_CANCEL_FD	:= 1 shl 1
IORING_ASYNC_CANCEL_FD_FIXED := 1 shl 3

; cqe->flags
IORING_CQE_F_MORE	:= 1 shl 1

; struct io_uring_sqe (64 bytes)
SQE_OPCODE	:= 0
SQE_FLAGS	:= 1
SQE_IOPRIO	:= 2
SQE_FD		:= 4
SQE_OFF		:= 8
SQE_ADDR	:= 16
SQE_LEN		:= 24
SQE_OP_FLAGS	:= 28		; msg_flags, timeout_flags, cancel_flags, ...
SQE_USER_DATA	:= 32
SQE_FILE_INDEX	:= 44
SQE_ADDR3	:= 48
SQE_SIZE	:= 64

; struct io_uring_cqe (16 bytes)
CQE_USER_DATA	:= 0
CQE_RES		:= 8
CQE_FLAGS	:= 12
CQE_SIZE	:= 16

; added for okena
IORING_OP_SOCKET		:= 45
IOSQE_IO_HARDLINK		:= 1 shl 3
IOSQE_BUFFER_SELECT		:= 1 shl 5
IORING_CQE_F_BUFFER		:= 1 shl 0
IORING_CQE_BUFFER_SHIFT		:= 16
IORING_REGISTER_PBUF_RING	:= 22
IORING_REGISTER_FILE_ALLOC_RANGE := 25
SQE_BUF_GROUP			:= 40	; u16
SQE_CMD_OP			:= 8	; u32 (uring_cmd)
SQE_LEVEL			:= 16	; u32 (setsockopt)
SQE_OPTNAME			:= 20	; u32
SQE_OPTLEN			:= 44	; u32
SQE_OPTVAL			:= 48	; u64
SOCKET_URING_OP_SETSOCKOPT	:= 3
; struct io_uring_buf (16 bytes); the ring tail is the u16 at offset 14
BUF_ADDR			:= 0
BUF_LEN				:= 8
BUF_BID				:= 12
BUF_TAIL			:= 14
IORING_OP_POLL_ADD		:= 6
POLLIN_				:= 0x0001
POLLRDHUP_			:= 0x2000
